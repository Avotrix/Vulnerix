# ── Email Provider: Microsoft Graph (OAuth2 app-only) OR SMTP ──────────────────
# v2.0.0 supports BOTH. Configure one:
#
# Option 1: Microsoft Graph (recommended for Office365)
# Avoids SMTP AUTH issues. Requires Azure AD app with Mail.Send permission.
MS_TENANT_ID="your-azure-tenant-id"
MS_CLIENT_ID="your-azure-app-client-id"
MS_CLIENT_SECRET="your-azure-app-client-secret"
SMTP_FROM_EMAIL="support@yourdomain.com"
#
# Option 2: SMTP (Gmail, Outlook, any SMTP server)
# Falls back if Graph creds are not set.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
