# ── Frontend (Vite build args) ────────────────────────────────────────────────
# Supabase API URL — use http://localhost:8000 for local docker setup
VITE_SUPABASE_URL="http://localhost:8000"
# Supabase anon/publishable key (safe to expose in frontend)
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# ── NVD Fetcher ───────────────────────────────────────────────────────────────
# Get a free API key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY="your-nvd-api-key"
# Fetch CVEs published from this year onwards (min: 2019)
NVD_START_YEAR="2021"

# ── PostgreSQL (direct connection to Supabase DB) ─────────────────────────────
# Use port 5433 if you exposed supabase-db directly in docker-compose
POSTGRES_HOST="localhost"
POSTGRES_PORT="5433"
POSTGRES_DB="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-postgres-password"
